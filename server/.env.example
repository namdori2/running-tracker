# 이 파일을 복사해서 .env 로 만들고 실제 값을 채워넣으세요.
# cp .env.example .env   (PowerShell: Copy-Item .env.example .env)

# JWT 서명 비밀키 (아무 임의의 긴 문자열이면 됩니다)
JWT_SECRET=change-this-to-a-random-long-string

# 카카오 개발자 콘솔(https://developers.kakao.com) > 내 애플리케이션 > 앱 키 > REST API 키
KAKAO_REST_API_KEY=

# 카카오 콘솔 > 제품 설정 > 카카오 로그인 > Redirect URI 에 아래와 "정확히" 동일하게 등록
# <LAN IP>는 mobile/src/config.js 의 API_BASE_URL 과 동일한 주소를 사용하세요.
KAKAO_REDIRECT_URI=http://192.168.0.5:4000/auth/kakao/callback
